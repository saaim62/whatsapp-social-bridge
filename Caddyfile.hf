:7860 {
    # NextAuth API routes MUST go to Next.js frontend
    handle /api/auth/* {
        reverse_proxy 127.0.0.1:3000
    }
    # All other API routes go to NestJS backend
    handle /api/* {
        reverse_proxy 127.0.0.1:3001
    }
    # Frontend pages go to Next.js
    handle /* {
        reverse_proxy 127.0.0.1:3000
    }
}
