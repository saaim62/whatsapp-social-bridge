DATABASE_URL=
REDIS_HOST=
REDIS_PORT=

# Comma-separated CORS allowlist for the API. Optional: when unset,
# defaults to http://localhost:3000 and https://droproute.duckdns.org
ALLOWED_ORIGINS=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

LLM_API_KEY=

AUTO_PUBLISH=
BATCH_WINDOW_SECONDS=
NEXT_PUBLIC_APP_URL=

# Meta token encryption at rest (AES-256-GCM). REQUIRED in production —
# the API refuses to boot without it. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# HMAC secret for short-lived signed media URLs used by Meta publishing.
# Optional: falls back to JWT_SECRET when unset.
MEDIA_SIGNING_SECRET=
