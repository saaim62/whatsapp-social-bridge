generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  batches       ProductBatch[]
  settings      Settings?
  sources       WhatsappSource[]
  socialAccounts SocialAccount[]
  whatsappContacts WhatsappContact[]
}

model SocialAccount {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             String
  accessToken          String?
  facebookPageId       String?
  instagramUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, platform])
}

model ProductBatch {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappMessageId String?
  senderId         String?
  senderName       String?
  rawText          String?
  extractedData    Json?
  status           String            @default("RECEIVED") // RECEIVED, PROCESSING, READY, APPROVED, PUBLISHING, PUBLISHED, PARTIALLY_PUBLISHED, FAILED
  mediaAssets      MediaAsset[]
  generatedContent GeneratedContent?
  publications     Publication[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, status])
}

model MediaAsset {
  id             String       @id @default(uuid())
  batchId        String
  batch          ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  whatsappMediaId String?
  mimeType       String?
  localPath      String?
  originalUrl    String?
  ocrConfidence  Float?
  needsManualReview Boolean @default(false)
  isProcessing   Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model GeneratedContent {
  id               String       @id @default(uuid())
  batchId          String       @unique
  batch            ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instagramCaption String?
  facebookCaption  String?
  storyText        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Publication {
  id             String       @id @default(uuid())
  batchId        String
  batch          ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  platform       String       // INSTAGRAM, FACEBOOK, STORY
  platformPostId String?
  status         String       @default("PENDING") // PENDING, PUBLISHED, FAILED
  error          String?
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?
}

model Settings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isSyncActive          Boolean  @default(true)
  historySyncDepthHours Int      @default(24) // 6, 24, 72, 168, 336, 720
  updatedAt             DateTime @updatedAt
}

model WhatsappSource {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jid       String
  name      String
  type      String   @default("GROUP") // GROUP, CHANNEL, INDIVIDUAL
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jid])
}

model WhatsappContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jid       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jid])
}
